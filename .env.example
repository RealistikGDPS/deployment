# Compose-level settings. Copy to .env; application settings live in
# configuration/*.env.

# Image tags to run. Pin to sha-<commit> in production; latest is for dev.
POLTERGEIST_TAG=latest
PANEL_TAG=latest
MIGRATE_TAG=latest

# The only port the stack publishes. Cloudflare terminates TLS and connects
# to this port over HTTP.
HTTP_PORT=80

# Path the game client is patched to use, without a trailing slash. The app
# always serves /database as well, because the client appends that to the
# URL returned by getAccountURL.
GAME_PATH=/database

# The app, panel, migrate page and migrations run as this host user, which must own
# DATA_PATH/storage. `make setup` fills it in from `id`.
APP_UID=1000
APP_GID=1000

# Where MySQL, Redis and object storage live on the host.
DATA_PATH=./volumes

# Where scripts/backup.sh writes and how many days it keeps.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14

# Uvicorn worker processes for the game server. Each holds its own MySQL pool
# (MYSQL_POOL_MAX connections), so keep APP_WORKERS * MYSQL_POOL_MAX plus the
# panel's pool under MYSQL_MAX_CONNECTIONS.
APP_WORKERS=4

# Memory and I/O. Sized for the reference deployment, a dedicated 6 vCPU,
# 12 GB, no-swap VPS on SSD. Idle usage measured there is roughly 90 MB per
# app worker, 180 MB for the panel, 150 MB for the migrate page, 300 MB for MySQL, 2 MB in Redis and 6 MB
# for nginx; the database is under 20 MB, so the buffer pool holds all of it
# with years of headroom. The caps sum to about 5.3 GB, leaving the rest to
# the page cache. Halve everything for a 6 GB box; on spinning disks drop the
# I/O capacity to 200 and 400.
NGINX_MEMORY_LIMIT=256m
NGINX_TMP_SIZE=128m
APP_MEMORY_LIMIT=1g
PANEL_MEMORY_LIMIT=1g
MIGRATE_MEMORY_LIMIT=512m
MYSQL_MEMORY_LIMIT=2g
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_MAX_CONNECTIONS=150
MYSQL_IO_CAPACITY=1000
MYSQL_IO_CAPACITY_MAX=2000
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb

# Embedded DNS the nginx container resolves upstreams through.
# Docker: 127.0.0.11. Podman: the gateway of the compose network, e.g. 10.89.0.1.
NGINX_RESOLVER=127.0.0.11

# Development only: host ports for the database and cache.
MYSQL_DEV_PORT=3306
REDIS_DEV_PORT=6379
