# Compose-level settings. Copy to .env; application settings live in
# configuration/*.env.

# Image tags to run. Pin to sha-<commit> in production; latest is for dev.
POLTERGEIST_TAG=latest
WEB_TAG=latest
DISCORD_TAG=latest

# The only port the stack publishes. Cloudflare terminates TLS and connects
# to this port over HTTP.
HTTP_PORT=80

# Path the game client is patched to use, without a trailing slash. The app
# always serves /database as well, because the client appends that to the
# URL returned by getAccountURL.
GAME_PATH=/database

# The app, website and migrations run as this host user, which must own
# DATA_PATH/storage, and nginx serves DATA_PATH/storage/songs as /songs and
# DATA_PATH/files (client builds) as /files. The website reads the game's icon
# sprites from DATA_PATH/assets.
# `make setup` fills it in from `id`.
APP_UID=1000
APP_GID=1000

# Where MySQL, Redis and object storage live on the host.
DATA_PATH=./volumes

# Where scripts/backup.sh writes and how many days it keeps.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14

# Uvicorn worker processes for the game server and the website. Each holds
# its own MySQL pool (MYSQL_POOL_MAX connections), so keep
# (APP_WORKERS + WEB_WORKERS) * MYSQL_POOL_MAX under MYSQL_MAX_CONNECTIONS.
APP_WORKERS=4
WEB_WORKERS=2

# Memory and I/O. Sized for the reference deployment, a dedicated 6 vCPU,
# 12 GB, no-swap VPS on SSD. Idle usage measured there is roughly 90 MB per
# app worker, 300 MB for MySQL, 2 MB in Redis and 6 MB for nginx; a website
# worker starts near 90 MB and grows with the icon atlases it has read. The
# database is under 20 MB, so the buffer pool holds all of it with years of
# headroom. The caps sum to about 4.3 GB, leaving the rest to the page cache.
# Halve everything for a 6 GB box; on spinning disks drop the I/O capacity
# to 200 and 400.
NGINX_MEMORY_LIMIT=256m
NGINX_TMP_SIZE=128m
APP_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=1g
MYSQL_MEMORY_LIMIT=2g
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_MAX_CONNECTIONS=150
MYSQL_IO_CAPACITY=1000
MYSQL_IO_CAPACITY_MAX=2000
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb
# The Discord relay, when enabled (see configuration/discord.env).
DISCORD_MEMORY_LIMIT=128m

# Embedded DNS the nginx container resolves upstreams through.
# Docker: 127.0.0.11. Podman: the gateway of the compose network, e.g. 10.89.0.1.
NGINX_RESOLVER=127.0.0.11

# Development only: host ports for the database and cache.
MYSQL_DEV_PORT=3306
REDIS_DEV_PORT=6379
