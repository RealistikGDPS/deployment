# Routes the public port: the control room lives under /panel, custom songs
# are served from object storage under /songs, client downloads from /files,
# the game server takes /database (and the patched game path) plus /api, and
# the website takes everything else.
#
# Rendered by the nginx image's envsubst; ${NGINX_RESOLVER} and
# ${NGINX_GAME_PATH} are replaced.
# Everything here lands inside the http {} block of the image's nginx.conf.

include /etc/nginx/cloudflare.conf;
real_ip_recursive on;

# Upstreams resolve through the embedded DNS and are re-resolved as
# containers restart, so any app may be down without taking nginx down.
resolver ${NGINX_RESOLVER} valid=10s;

upstream app {
    zone app 64k;
    server app:8000 resolve;
    keepalive 32;
}

upstream panel {
    zone panel 64k;
    server panel:8501 resolve;
    keepalive 8;
}

upstream web {
    zone web 64k;
    server web:8001 resolve;
    keepalive 16;
}

# Flood caps keyed on the real client address. The application applies its
# own per-endpoint limits; these only stop one address saturating a worker.
limit_req_zone $binary_remote_addr zone=game:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=admin:1m rate=5r/s;
limit_req_zone $binary_remote_addr zone=site:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_status 429;
limit_conn_status 429;

server_tokens off;

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript text/javascript application/xml;

server {
    listen 8080;
    server_name _;
    client_max_body_size 128m;
    absolute_redirect off;
    limit_conn perip 64;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /panel/ {
        proxy_pass http://panel;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
    }

    location = /panel {
        return 302 /panel/;
    }

    # Custom songs are files in object storage under songs/<id>.mp3 and the
    # songs table points here. They never change under one id, so clients
    # and Cloudflare may cache them for as long as they like. Range requests
    # let the client resume a download.
    location /songs/ {
        alias /srv/songs/;
        types { audio/mpeg mp3; }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # Client builds the download page links to. Large, rarely changed and
    # named per version, so they may be cached for a day.
    location /files/ {
        alias /srv/files/;
        types { application/zip zip; application/vnd.android.package-archive apk; }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options nosniff always;
    }

    location /api/v1/ {
        limit_req zone=admin burst=10 nodelay;
        proxy_pass http://app;
        proxy_set_header Connection "";
    }

    # Game endpoints. The app serves them under /database, which the client
    # also appends to the URL returned by getAccountURL; NGINX_GAME_PATH is
    # the base path patched into the client and is rewritten onto /database.
    # Level uploads and account saves are large; streaming them straight to
    # the app avoids buffering each body to disk first.
    location ~ ^(?:/database|${NGINX_GAME_PATH})/(?<endpoint>.*)$ {
        limit_req zone=game burst=60 nodelay;
        rewrite ^ /database/$endpoint break;
        proxy_pass http://app;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    # The website. Rendered icons carry their own immutable cache headers and
    # are keyed entirely by their path, so Cloudflare may cache them forever;
    # the stylesheet and script change with each release.
    location /icons/ {
        limit_req zone=site burst=100 nodelay;
        proxy_pass http://web;
        proxy_set_header Connection "";
        add_header X-Content-Type-Options nosniff always;
    }

    location /static/ {
        limit_req zone=site burst=100 nodelay;
        proxy_pass http://web;
        proxy_set_header Connection "";
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        limit_req zone=site burst=30 nodelay;
        proxy_pass http://web;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
    }
}
